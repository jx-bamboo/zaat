<div class="bg-dark p-4 rounded">
  <% if order.status == "pending" %>
    <!-- <div class="text-center text-light py-5">
      <div class="spinner-border" role="status">
        <span class="visually-hidden text-light">Loading...</span>
      </div>
      <div class="mt-3">Pending ...</div>
    </div> -->
    <div class="row col-sm-12 position-relative" id="mmodel" data-controller="three">
      <div id="three"></div>
    </div>
  <% elsif order.status == "completed" %>
    <div class="row col-sm-12 position-relative" id="mmodel" data-controller="three" data-three-orderid="order_<%= order.id %>">
      <div id="three"></div>
    </div>
  <% end %>
  
  <% if order.prompt.present? %>
    <div class="border border-secondary rounded p-2 text-secondary mt-3"><%= order.prompt %></div>
  <% end %>

  <div class="d-flex justify-content-evenly py-4">
    <button id="d_model" data-controller="download" data-action="download#get_model" data-download-url="<%= order.id%>" class="bg_gradient px-4 py-2 rounded-pill text-light border-0">Download</button>
    <button class="bg_gradient px-4 py-2 rounded-pill text-light border-0" disabled>NFT Marketplace</button>
  </div>
</div>